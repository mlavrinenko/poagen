#!/usr/bin/env bash
#
# Run infection, and fail loudly if it ever leaves mutated generator output
# looking committed.
#
# Why this exists. The fixture profiles under tests/fixtures/profiles/ used
# to point their `output:` at the committed golden trees themselves — e.g.
# parameters.php wrote to tests/fixtures/generated/parameters. That was fine
# for a normal test run, where the generator is correct and rewrites the tree
# byte-identically. Under mutation testing it was not: a mutant that changed
# emitted output made the test rewrite the GOLDEN with the mutant's output,
# and the corruption survived the run.
#
# Observed on 2026-08-02 with a single-file run against SecurityScheme.php: a
# mutant of `camelize()` left tests/fixtures/generated/parameters/Generated/
# ApiClient.php carrying `$ApiKey` instead of `$apiKey`, as a tracked
# modification. A `git commit -a` after a mutation run would have shipped
# mutated output as the golden truth, and every byte-stability assertion
# would then have agreed with it.
#
# fixtures-generate-to-a-scratch-tree fixed the actual cause: every profile
# under tests/fixtures/profiles/ now defaults `output:` to a scratch
# directory (see tests/fixtures/profiles/scratch-output.php), so a test run
# — mutated generator or not — has no default path back into
# tests/fixtures/generated/ at all. Regenerating a golden tree is still
# possible, but only on purpose, via `just regenerate-fixture <name>`'s
# explicit `--output` override, which nothing a mutated test run reaches.
#
# So this script no longer restores those trees afterwards — the restore was
# the guard, not the fix, and the fix now makes it unreachable in normal
# operation. What it still does: refuse to start dirty (otherwise there is
# no way to tell a mutant's damage from your own work in progress), and
# check the same paths again afterwards, FAILING rather than silently
# `git checkout --`ing them if either is dirty. If that check ever trips,
# the scratch-output fix regressed and the dirty tree is evidence to look
# at, not noise to discard.

set -eo pipefail

cd "$(dirname "$0")/.."

# Paths a generator run under test should never be able to write. Checked
# before and after every run; see the header for why nothing restores them
# any more.
GENERATED_PATHS=(tests/fixtures/generated examples)

# Only the generated trees have to be clean, not the whole tree — the point
# is to be able to attribute what is dirty AFTERWARDS to a mutant. Blocking
# on unrelated work in progress would make `mutate-fast`, whose whole purpose
# is iterating on uncommitted changes, impossible to run.
if [[ -n "$(git status --porcelain -- "${GENERATED_PATHS[@]}")" ]]; then
    echo "mutation-run: refusing to start — a generated tree is already dirty." >&2
    echo >&2
    echo "A generated tree should never be dirty going in — starting dirty makes a" >&2
    echo "mutant's damage indistinguishable from your own changes." >&2
    echo "Commit or discard these first:" >&2
    echo >&2
    git status --short -- "${GENERATED_PATHS[@]}" >&2
    exit 1
fi

set +e
env -u PHP_INI_SCAN_DIR php -d memory_limit=2G vendor/bin/infection run \
    --initial-tests-php-options="-d pcov.directory=. -d pcov.exclude=~(vendor|build)~" \
    "$@"
status=$?
set -e

dirty="$(git status --porcelain -- "${GENERATED_PATHS[@]}")"
if [[ -n "$dirty" ]]; then
    echo >&2
    echo "mutation-run: a generated tree changed during the run — this should be" >&2
    echo "impossible now that tests/fixtures/profiles/ default to a scratch output" >&2
    echo "directory (see tests/fixtures/profiles/scratch-output.php). Investigate" >&2
    echo "before doing anything else; do not just discard this:" >&2
    echo >&2
    echo "$dirty" >&2
    exit 1
fi

# Scratch directories the CLI's own argument parsing creates when a mutant
# breaks it mid-run (`--output=/` and friends land as literal directory names).
# Only ever removed when untracked, and only at the repository root.
while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    rm -rf -- "$path"
    echo "mutation-run: removed scratch path left by a mutated CLI run: $path"
done < <(git ls-files --others --exclude-standard --directory | grep -E '^(=|--output=|tmp/)' || true)

exit "$status"
