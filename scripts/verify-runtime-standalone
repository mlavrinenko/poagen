#!/usr/bin/env bash
# verify-runtime-standalone — prove runtime-package-split's central claim: a
# generated client installs and runs with poagen/client-runtime alone,
# with the generator (poagen/client-generator, devizzent/cebe-php-openapi, nette/php-
# generator, sebastian/diff) nowhere in vendor/.
#
# Builds a scratch composer project under build/ (git-ignored) that requires
# only poagen-runtime and a PSR-7 implementation, drops in a copy of the
# committed petstore example's generated tree, and drives one real operation
# through a stub transport.
#
# Not part of `just check` regardless (see `keep-the-standalone-runtime-check-
# from-rotting-outside-the-gate`): it builds a second, throwaway composer
# project under build/ on every run, which is a heavier and slower shape than
# anything else the offline gate does. That used to be paired with a real
# network dependency — composer resolving nyholm/psr7 from packagist — which
# was the original, and by 2026-08 the only remaining, reason this recipe sat
# outside `just check`. Re-examined and closed: every package this scratch
# project needs (nyholm/psr7 and its own transitive requirements) is already
# sitting in this repo's own root vendor/, installed the same way `just check`
# requires before it can run at all. The repositories below point straight at
# that vendor/ tree — and at runtime/ the same way the root project's own
# composer.json does — instead of packagist.org, which is explicitly disabled
# below it. `COMPOSER_DISABLE_NETWORK=1` backs that up: if a future dependency
# is not already vendored locally, this fails fast with a resolution error
# naming the missing package, rather than silently reaching the network.
#
# run.php's consumer call — how it builds an `ApiClient` — is derived from
# the installed generated tree by reflection, not hand-authored beside it
# (see `generate-the-standalone-harness-consumer-instead-of-hand-writing-it`
# and `truth/decisions/derive-the-standalone-consumer-instead-of-pinning-its-
# shape.decision-260808.typ`). That replaces the offline PHPUnit test that
# used to pin `ApiClient`'s constructor shape and `getPetById`'s return shape
# as source text — this script is now the only place either shape is
# checked, which is unchanged from before that test existed and is why this
# recipe still stays out of `just check` per that task's own non-goal.
set -eo pipefail

export COMPOSER_DISABLE_NETWORK=1

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
scratch="$root/build/verify-runtime-standalone"

rm -rf "$scratch"
mkdir -p "$scratch/client"
cp -r "$root/examples/petstore/generated/Generated" "$scratch/client/Generated"

# vendor/*/* below has no version-control metadata of its own to detect a
# version from — it is a plain subdirectory of this checkout, not a nested
# git repository — so composer's path-repository fallback would otherwise
# guess this checkout's own branch name for every package it matches, and
# that guess cannot satisfy a real constraint like nyholm/psr7's ^1.8. Force
# the correct version per package instead, read straight out of the root
# lockfile that already pins them for the rest of the gate (composer.lock is
# committed and only ever moves via `composer install` — see CONTRIBUTING.md)
# so this has nothing of its own to fall out of step. poagen/client-runtime
# is deliberately excluded: it already has its own dedicated path repository
# below with the "@dev" constraint the root project itself uses, and forcing
# a second, lock-derived version for the same directory here would just
# offer composer two conflicting versions of one package.
versions_json="$(php -r '
$lock = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
$versions = [];
foreach ([...$lock["packages"], ...$lock["packages-dev"]] as $package) {
    if ($package["name"] !== "poagen/client-runtime") {
        $versions[$package["name"]] = $package["version"];
    }
}
echo json_encode($versions, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
' "$root/composer.lock")"

cat > "$scratch/composer.json" <<JSON
{
    "name": "scratch/verify-runtime-standalone",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "poagen/client-runtime": "@dev",
        "nyholm/psr7": "^1.8"
    },
    "repositories": [
        {
            "type": "path",
            "url": "$root/runtime",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "$root/vendor/*/*",
            "options": {
                "symlink": true,
                "versions": $versions_json
            }
        },
        {
            "packagist.org": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Acme\\\\Petstore\\\\Generated\\\\": "client/Generated/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
JSON

cat > "$scratch/run.php" <<'PHP'
<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use Acme\Petstore\Generated\ApiClient;
use Acme\Petstore\Generated\Model\Pet;
use Composer\InstalledVersions;
use Nyholm\Psr7\Response;
use Poagen\Runtime\Contract\Endpoint;
use Poagen\Runtime\Contract\Envelope;
use Poagen\Runtime\Contract\ResponseType;
use Poagen\Runtime\Contract\TransportInterface;

foreach (['poagen/client-generator', 'devizzent/cebe-php-openapi', 'nette/php-generator', 'sebastian/diff'] as $generatorOnly) {
    if (InstalledVersions::isInstalled($generatorOnly)) {
        fwrite(STDERR, "FAIL: {$generatorOnly} is installed — the generator is not absent\n");
        exit(1);
    }
}

if (!InstalledVersions::isInstalled('poagen/client-runtime')) {
    fwrite(STDERR, "FAIL: poagen/client-runtime is not installed\n");
    exit(1);
}

// --- Derive ApiClient's constructor call from the installed class itself ---
//
// The old run.php hard-coded `new ApiClient($transport, 'scratch-api-key',
// 'scratch-oauth-token')`. That is exactly the copy that drifted twice
// (security-wiring added a parameter, typed-error-responses changed a
// return shape) while nobody ran this recipe. Reading the constructor via
// Reflection instead of hard-coding it means there is nothing left here to
// fall out of step with the generated shape — this loop follows whatever
// ApiClient::__construct() currently declares, in whatever order.
//
// It understands exactly two parameter kinds: a TransportInterface (the
// transport every generated client needs) and a string (a credential per
// declared security scheme — apiKey, bearer token, whatever the document
// names it). A parameter of any other required, undeclared-default kind is
// a shape this derivation was not taught, so it fails loudly and names the
// parameter rather than guessing a value that might silently pass.
$apiClientClass = new ReflectionClass(ApiClient::class);
$constructor = $apiClientClass->getConstructor();

if ($constructor === null) {
    fwrite(STDERR, "FAIL: ApiClient has no constructor to derive a call from\n");
    exit(1);
}

$namedArgs = [];
$credentialPlaceholders = [];
$transportParamName = null;

foreach ($constructor->getParameters() as $param) {
    $type = $param->getType();
    $typeName = $type instanceof ReflectionNamedType ? $type->getName() : null;

    if ($typeName === TransportInterface::class) {
        $transportParamName = $param->getName();

        continue;
    }

    if ($typeName === 'string') {
        // A distinct, traceable placeholder per parameter name — not the
        // real credential a vendor would issue, since the stub transport
        // below never validates one. It exists so the stub transport can
        // confirm this exact value reached the outgoing request, which is
        // the part actually worth proving offline.
        $placeholder = 'verify-standalone-cred-' . $param->getName();
        $namedArgs[$param->getName()] = $placeholder;
        $credentialPlaceholders[$param->getName()] = $placeholder;

        continue;
    }

    if ($param->isOptional()) {
        continue;
    }

    fwrite(
        STDERR,
        "FAIL: don't know how to construct ApiClient's required parameter \${$param->getName()} "
            . 'of type ' . ($typeName ?? '(no declared type)') . ' — this derivation only understands '
            . "TransportInterface and string; extend scripts/verify-runtime-standalone if a new kind of "
            . "constructor parameter has appeared\n",
    );
    exit(1);
}

if ($transportParamName === null) {
    fwrite(STDERR, "FAIL: ApiClient's constructor declares no TransportInterface-typed parameter\n");
    exit(1);
}

// Known gap: this proves each credential placeholder reaches the outgoing
// request *somewhere* (a header value or the URI), not that it reaches the
// *specific* header or place its own security scheme requires. Two
// same-typed credentials wired to each other's header — apiKey ending up
// in the Authorization header and petstoreAuth in api_key — would still
// pass this check, since both placeholders would still be present, just
// swapped. Nothing here reads the OpenAPI document to know which header a
// given scheme is supposed to use.
$transport = new class($credentialPlaceholders) implements TransportInterface {
    /** @param array<string, string> $credentialPlaceholders */
    public function __construct(private readonly array $credentialPlaceholders)
    {
    }

    public function send(Endpoint $endpoint, ResponseType $expected): mixed
    {
        if ($endpoint->uri() !== '/pet/42') {
            fwrite(STDERR, "FAIL: unexpected endpoint {$endpoint->uri()}\n");
            exit(1);
        }

        $wire = $endpoint->uri() . '|' . implode('|', $endpoint->headers());

        foreach ($this->credentialPlaceholders as $paramName => $placeholder) {
            if (!str_contains($wire, $placeholder)) {
                fwrite(
                    STDERR,
                    "FAIL: constructor argument \${$paramName} never reached the request — expected "
                        . "\"{$placeholder}\" in the URI or a header, got: {$wire}\n",
                );
                exit(1);
            }
        }

        return new Envelope(200, new Pet(name: 'Rex', photoUrls: []), new Response());
    }
};

$namedArgs[$transportParamName] = $transport;
$apiClient = $apiClientClass->newInstance(...$namedArgs);

// --- The rest stays a named, concrete call ---
//
// Which sub-client to fetch and which operation to call is domain
// knowledge (petstore is the harness's subject on purpose — this task does
// not generalise to the other examples), so it is still spelled out here
// rather than derived. A rename of either fails loudly by name below,
// rather than as a bare "call to undefined method" fatal.
if (!method_exists($apiClient, 'pet')) {
    fwrite(STDERR, "FAIL: ApiClient no longer exposes pet() — this harness calls it by name\n");
    exit(1);
}

$petClient = $apiClient->pet();

if (!method_exists($petClient, 'getPetById')) {
    fwrite(STDERR, "FAIL: pet() no longer exposes getPetById() — this harness calls it by name\n");
    exit(1);
}

$result = $petClient->getPetById(42);

// Every operation returning a status-and-body Envelope is an accepted
// decision (envelope-supersedes-error-response-policy, 2026-08-04), not
// one of two live shapes this harness should tolerate — so this asserts
// the Envelope wrapping by name rather than falling back to reading
// $result directly were it ever a bare Pet again. A revert of that
// decision is exactly the kind of change this harness should go red on.
if (!$result instanceof Envelope) {
    fwrite(STDERR, 'FAIL: expected getPetById to return an Envelope, got ' . get_debug_type($result) . "\n");
    exit(1);
}

if ($result->status !== 200) {
    fwrite(STDERR, "FAIL: expected status 200, got {$result->status}\n");
    exit(1);
}

$pet = $result->body;

if (!$pet instanceof Pet) {
    fwrite(STDERR, 'FAIL: expected getPetById to produce a Pet, got ' . get_debug_type($pet) . "\n");
    exit(1);
}

if ($pet->name !== 'Rex') {
    fwrite(STDERR, "FAIL: expected hydrated Pet named Rex, got {$pet->name}\n");
    exit(1);
}

echo "OK: generated client ran on poagen/client-runtime alone (generator absent)\n";
PHP

cd "$scratch"
composer install --no-interaction --no-progress
php run.php
