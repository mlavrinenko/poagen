#!/usr/bin/env bash
# verify-runtime-standalone — prove runtime-package-split's central claim: a
# generated client installs and runs with poagen/client-runtime alone,
# with the generator (poagen/client-generator, devizzent/cebe-php-openapi, nette/php-
# generator, sebastian/diff) nowhere in vendor/.
#
# Builds a scratch composer project under build/ (git-ignored) that requires
# only poagen-runtime and a PSR-7 implementation, drops in a copy of the
# committed petstore example's generated tree, and drives one real operation
# through a stub transport. Not part of `just check`: composer resolves
# nyholm/psr7 from the network/cache, which the offline gate does not assume.
set -eo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
scratch="$root/build/verify-runtime-standalone"

rm -rf "$scratch"
mkdir -p "$scratch/client"
cp -r "$root/examples/petstore/generated/Generated" "$scratch/client/Generated"

cat > "$scratch/composer.json" <<JSON
{
    "name": "scratch/verify-runtime-standalone",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "poagen/client-runtime": "@dev",
        "nyholm/psr7": "^1.8"
    },
    "repositories": [
        {
            "type": "path",
            "url": "$root/runtime",
            "options": {"symlink": true}
        }
    ],
    "autoload": {
        "psr-4": {
            "Acme\\\\Petstore\\\\Generated\\\\": "client/Generated/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
JSON

cat > "$scratch/run.php" <<'PHP'
<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use Acme\Petstore\Generated\ApiClient;
use Acme\Petstore\Generated\Model\Pet;
use Composer\InstalledVersions;
use Nyholm\Psr7\Response;
use Poagen\Runtime\Contract\Endpoint;
use Poagen\Runtime\Contract\Envelope;
use Poagen\Runtime\Contract\ResponseType;
use Poagen\Runtime\Contract\TransportInterface;

foreach (['poagen/client-generator', 'devizzent/cebe-php-openapi', 'nette/php-generator', 'sebastian/diff'] as $generatorOnly) {
    if (InstalledVersions::isInstalled($generatorOnly)) {
        fwrite(STDERR, "FAIL: {$generatorOnly} is installed — the generator is not absent\n");
        exit(1);
    }
}

if (!InstalledVersions::isInstalled('poagen/client-runtime')) {
    fwrite(STDERR, "FAIL: poagen/client-runtime is not installed\n");
    exit(1);
}

$transport = new class implements TransportInterface {
    public function send(Endpoint $endpoint, ResponseType $expected): mixed
    {
        if ($endpoint->uri() !== '/pet/42') {
            fwrite(STDERR, "FAIL: unexpected endpoint {$endpoint->uri()}\n");
            exit(1);
        }

        return new Envelope(200, new Pet(name: 'Rex', photoUrls: []), new Response());
    }
};

// The document declares both an apiKey and an oauth2 scheme for petstore, so
// the generated client takes a credential for each beside the transport.
$envelope = new ApiClient($transport, 'scratch-api-key', 'scratch-oauth-token')
    ->pet()
    ->getPetById(42);

if ($envelope->status !== 200) {
    fwrite(STDERR, "FAIL: expected status 200, got {$envelope->status}\n");
    exit(1);
}

$pet = $envelope->body;

if (!$pet instanceof Pet) {
    fwrite(STDERR, "FAIL: expected the envelope body to hydrate into a Pet\n");
    exit(1);
}

if ($pet->name !== 'Rex') {
    fwrite(STDERR, "FAIL: expected hydrated Pet named Rex, got {$pet->name}\n");
    exit(1);
}

echo "OK: generated client ran on poagen/client-runtime alone (generator absent)\n";
PHP

cd "$scratch"
composer install --no-interaction --no-progress
php run.php
