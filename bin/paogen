#!/usr/bin/env php
<?php

declare(strict_types=1);

// Find the composer autoloader whether we're in vendor/bin or the repo root.
$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',         // running from repo root
    __DIR__ . '/../../../autoload.php',          // installed as a dependency
];

$autoloader = null;
foreach ($autoloaders as $candidate) {
    if (is_file($candidate)) {
        $autoloader = $candidate;
        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, "paogen: could not locate composer autoloader. Did you run `composer install`?\n");
    exit(1);
}

require $autoloader;

// Silence E_DEPRECATED from the `cebe/php-openapi` parser on PHP 8.4.
// Tracked for replacement by truth/tasks/016-cebe-php-openapi-replacement.typ.
error_reporting(error_reporting() & ~E_DEPRECATED & ~E_USER_DEPRECATED);

exit(Mlavrinenko\Paogen\Cli::run($argv));
