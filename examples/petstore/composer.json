{
    "name": "acme/poagen-petstore-example",
    "description": "Example consumer project that generates a typed Petstore client via poagen.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "poagen/client-runtime": "@dev",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "poagen/client-generator": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../runtime",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Acme\\Petstore\\Generated\\": "generated/Generated/",
            "Acme\\Petstore\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "generate": "poagen generate poagen.php"
    }
}
