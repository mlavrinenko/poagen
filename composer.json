{
    "name": "mlavrinenko/paogen",
    "description": "OpenAPI-driven PHP client generator producing typed, extensible clients.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "openapi",
        "openapi3",
        "generator",
        "client",
        "http-client",
        "code-generation",
        "sdk"
    ],
    "authors": [
        {
            "name": "Maxim Lavrinenko",
            "email": "maxim@lavrinenko.xyz"
        }
    ],
    "require": {
        "php": "^8.4",
        "cebe/php-openapi": "^1.7",
        "mlavrinenko/paogen-runtime": "*@dev",
        "nette/php-generator": "^4.2",
        "psr/http-message": "^2.0",
        "sebastian/diff": "^6.0 || ^7.0"
    },
    "require-dev": {
        "cweagans/composer-patches": "^1.7",
        "friendsofphp/php-cs-fixer": "^3.92",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.1",
        "rector/rector": "^2.3",
        "shipmonk/dead-code-detector": "^1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "runtime",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["bin/paogen"],
    "autoload": {
        "psr-4": {
            "Mlavrinenko\\Paogen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mlavrinenko\\Paogen\\Tests\\": "tests/",
            "Mlavrinenko\\Paogen\\Tests\\Generated\\": "tests/generated/",
            "Mlavrinenko\\Paogen\\Tests\\Integration\\": "tests/Integration/",
            "Mlavrinenko\\Paogen\\Tests\\Fixtures\\ValueObject\\": "tests/fixtures/profiles/value-objects/",
            "Acme\\Kilbil\\ValueObject\\": "examples/kilbil/src/ValueObject/",
            "Mlavrinenko\\Paogen\\Tests\\Fixtures\\Generated\\Petstore\\": "tests/fixtures/generated/petstore/",
            "Mlavrinenko\\Paogen\\Tests\\Fixtures\\Generated\\Contact\\": "tests/fixtures/generated/contact/",
            "Mlavrinenko\\Paogen\\Tests\\Fixtures\\Generated\\Composition\\": "tests/fixtures/generated/composition/",
            "Mlavrinenko\\Paogen\\Tests\\Fixtures\\Generated\\Parameters\\": "tests/fixtures/generated/parameters/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "cebe/php-openapi": {
                "PHP 8.4: explicit nullable parameters (T-016)": "patches/cebe-php-openapi-php84-nullable.patch"
            }
        }
    },
    "scripts": {
        "lint": [
            "@lint:cs-fixer",
            "@lint:phpstan",
            "@lint:rector"
        ],
        "lint:cs-fixer": "php-cs-fixer fix --diff --verbose --dry-run",
        "lint:phpstan": "phpstan analyse --memory-limit=512M",
        "lint:rector": "rector --dry-run",
        "format": "php-cs-fixer fix --diff --verbose",
        "format:rector": "rector",
        "test": "phpunit",
        "test:coverage": [
            "env -u PHP_INI_SCAN_DIR php -d pcov.directory=. -d 'pcov.exclude=~(vendor|build)~' vendor/bin/phpunit --coverage-html build/coverage --coverage-clover build/logs/clover.xml",
            "scripts/coverage-floor build/logs/clover.xml src=87.0 runtime/src=88.0"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
