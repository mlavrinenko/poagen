includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/shipmonk/dead-code-detector/rules.neon
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
  tmpDir: ./build/cache/phpstan
  treatPhpDocTypesAsCertain: false
  level: max
  paths:
    - bin
    - src
    - tests
  excludePaths:
    # Generated code is checked by a separate config so the consumer's
    # PHPStan setup is what gates it (ADR-004).
    - tests/fixtures/generated/*
  ignoreErrors:
    - identifier: shipmonk.deadProperty.neverRead
      path: tests/generated/*Steps.php
    - identifier: property.onlyWritten
      path: tests/generated/*Steps.php
    # Generated PHPUnit stubs call markTestIncomplete on $this for draft
    # scenarios. PHPUnit allows the pattern idiomatically, and the stubs
    # are produced by speconaut-phpunit, so we can't rewrite them.
    - identifier: staticMethod.dynamicCall
      path: tests/generated/*Test.php
    # Runtime attribute classes are a public ABI: their public properties
    # are read by user code (and future runtime registries) via
    # reflection on the attribute instance. Shipmonk's static analysis
    # cannot see those reflection reads, so the dead-property warning
    # does not apply. See ADR-010.
    - identifier: shipmonk.deadProperty.neverRead
      path: src/Runtime/Attribute/*
    # Marshaller/Hydrator round-trip fixtures hold properties that are
    # only read via reflection — same blind spot as above.
    - identifier: shipmonk.deadProperty.neverRead
      path: tests/Unit/Runtime/Fixtures/*
    - identifier: shipmonk.deadEnumCase
      path: tests/Unit/Runtime/Fixtures/*
