includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/shipmonk/dead-code-detector/rules.neon
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
  tmpDir: ./build/cache/phpstan
  treatPhpDocTypesAsCertain: false
  level: max
  paths:
    - bin
    - src
    - runtime/src
    - tests
  excludePaths:
    # Generated code is checked by a separate config so the consumer's
    # PHPStan setup is what gates it (`quality-gates-at-maximum-strictness`).
    - tests/fixtures/generated/*
  # kilbil-recorded-response-proof: tests/Integration/Kilbil/* import
  # Acme\Kilbil\Generated\* to drive the real, committed ApiClient over the
  # real HttpTransport. That tree lives under examples/kilbil/generated and
  # is analysed on its own, separate, consumer-view config
  # (`quality-gates-at-maximum-strictness`, see examples/kilbil/phpstan.neon)
  # — it is not this config's job to type-check
  # it. scanDirectories only makes the symbols discoverable so this config's
  # own analysis of tests/ doesn't report class.notFound on a class that does
  # exist, one tier over; it does not put those files under analysis here
  # (same split phpstan-generated.neon:23 already uses for
  # tests/fixtures/profiles/value-objects).
  scanDirectories:
    - examples/kilbil/generated
  ignoreErrors:
    # speconaut-php-phpunit's StepStub::stubBody() appends
    # `$this->test->fail('Implement: ...')` for any spec step that does not
    # yet have a hand-written body, on every *Steps.php it generates —
    # $test exists so that call has a TestCase to reach. Whether the
    # property is ever read is a function of which specs currently lack a
    # body, not of this file's own logic: read it out of `ignoreErrors` and
    # the gate goes red the moment every step in some *Steps.php happens to
    # already be implemented, exactly as it did here when
    # pre-transport-claims-survive-the-sweep filled in the last pending
    # stub. Scoped to the exact property, not the whole file, so an
    # unrelated dead property in the same class still fails — see the
    # removed $boundFormat case in ProfileSteps.php (revert-the-strictness-
    # relaxation), which this exemption never covered.
    - identifier: shipmonk.deadProperty.neverRead
      path: tests/generated/*Steps.php
      message: '#::\$test is never read$#'
    - identifier: property.onlyWritten
      path: tests/generated/*Steps.php
      message: '#::\$test is never read, only written\.$#'
