includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/shipmonk/dead-code-detector/rules.neon
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
  tmpDir: ./build/cache/phpstan
  treatPhpDocTypesAsCertain: false
  level: max
  paths:
    - bin
    - src
    - tests
  excludePaths:
    # Generated code is checked by a separate config so the consumer's
    # PHPStan setup is what gates it (ADR-004).
    - tests/fixtures/generated/*
  ignoreErrors:
    - identifier: shipmonk.deadProperty.neverRead
      path: tests/generated/*Steps.php
    - identifier: property.onlyWritten
      path: tests/generated/*Steps.php
    # Fixture VOs exist to prove BindsFormat discovery; their fields are
    # never read in PHP-land.
    - identifier: shipmonk.deadProperty.neverRead
      path: tests/fixtures/profiles/value-objects/*.php
    - identifier: shipmonk.deadMethod
      path: tests/fixtures/profiles/value-objects/*.php
