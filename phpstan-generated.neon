# Independent PHPStan config for the generated fixtures
# (`quality-gates-at-maximum-strictness`).
# This is the *consumer view* — generated code must pass max as if a user
# were running phpstan in their own project.
includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
  tmpDir: ./build/cache/phpstan-generated
  treatPhpDocTypesAsCertain: false
  level: max
  # No `paths:` here on purpose. PHPStan hard-errors when a listed path
  # does not exist, but not every examples/*/generated tree exists —
  # examples marked .expected-failure have no generated/ dir at all
  # (see check-examples). `just lint-phpstan-generated` passes
  # tests/fixtures/generated on the command line directly (see that
  # recipe). Every examples/*/ directory also `includes:` this file from
  # its own phpstan.neon and passes its own path set — `generated/` when
  # it exists, `src/` when it exists — on the command line the same way
  # (see examples/<name>/Justfile). Running this config with no paths on
  # the CLI fails loudly ("At least one path must be specified to
  # analyse") instead of silently analysing nothing.
  scanDirectories:
    - tests/fixtures/profiles/value-objects
