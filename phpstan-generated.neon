# Independent PHPStan config for the generated fixtures (ADR-004).
# This is the *consumer view* — generated code must pass max as if a user
# were running phpstan in their own project.
includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
  tmpDir: ./build/cache/phpstan-generated
  treatPhpDocTypesAsCertain: false
  level: max
  # No `paths:` here on purpose. PHPStan hard-errors when a listed path
  # does not exist, but not every examples/*/generated tree exists —
  # examples marked .expected-failure have no generated/ dir at all
  # (see check-examples). The real path set — tests/fixtures/generated
  # plus every examples/*/generated tree that currently exists — is
  # glob-expanded and passed on the command line by
  # `just lint-phpstan-generated`, so it grows automatically as more
  # examples clear their .expected-failure marker. Running this config
  # with no paths on the CLI fails loudly ("At least one path must be
  # specified to analyse") instead of silently analysing nothing.
  scanDirectories:
    - tests/fixtures/profiles/value-objects
