#   src/spec/Paths.php:249           resolveReferences(?ReferenceContext ...)
#   src/spec/Reference.php:72        __construct(array, ?string $to = null)
#   src/spec/Reference.php:179       resolve(?ReferenceContext ...)
#   src/spec/Reference.php:366       resolveReferences(?ReferenceContext ...)
#   src/spec/Responses.php:239       resolveReferences(?ReferenceContext ...)
#
# Applied by cweagans/composer-patches during `composer install`.
# Tracked by truth/tasks/016-cebe-php-openapi-replacement.typ.
#
