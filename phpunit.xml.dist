<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="./tests/bootstrap.php" colors="true" cacheDirectory="./build/cache/phpunit">
  <testsuites>
    <testsuite name="unit-tests">
      <directory>./tests</directory>
    </testsuite>
  </testsuites>
  <coverage/>
  <php>
    <ini name="memory_limit" value="1G"/>
  </php>
  <!--
        Scope deprecation tracking to `src/`. This keeps PHP 8.4 implicit-nullable
        deprecations emitted by `cebe/php-openapi` (P2 #15 in the pre-release review,
        tracked under truth/tasks/) out of PHPUnit's summary without hiding any
        deprecations that we trigger ourselves.
    -->
  <source restrictNotices="true" restrictWarnings="true" ignoreIndirectDeprecations="true">
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
</phpunit>
