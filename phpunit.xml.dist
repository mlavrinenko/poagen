<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="./tests/bootstrap.php" colors="true" cacheDirectory="./build/cache/phpunit">
  <testsuites>
    <testsuite name="unit-tests">
      <directory>./tests</directory>
    </testsuite>
    <!--
        Separate from the `unit-tests` suite above on purpose: `./tests`
        does not reach outside itself, so `runtime/tests` needs its own
        entry or the moved suite silently stops running under the root
        gate — exactly the coverage-floor gap
        `bundle-the-runtime-package-with-its-own-ci-tooling` exists to
        close (`runtime/src=92.0` in `Justfile`'s `test-coverage` recipe
        has nothing to measure without these tests actually executing).
        `runtime/phpunit.xml.dist` carries the identical
        `<directory>./tests</directory>` line relative to `runtime/`, for
        the same suite run standalone once `runtime/` is split off — the
        two are not one config delegating to the other because a single
        phpunit.xml cannot be relative to two different roots at once;
        keep them in sync by hand if this suite's shape ever changes.
    -->
    <testsuite name="runtime-tests">
      <directory>./runtime/tests</directory>
    </testsuite>
  </testsuites>
  <coverage/>
  <php>
    <ini name="memory_limit" value="1G"/>
  </php>
  <!--
        Deprecation tracking is scoped to our own code and nothing is ignored.
        `ignoreIndirectDeprecations="true"` used to sit here for one reason: the
        PHP 8.4 implicit-nullable deprecations `cebe/php-openapi` emitted (P2 #15
        in the pre-release review), the same ones the deleted
        `patches/cebe-php-openapi-php84-nullable.patch` existed to silence.
        `devizzent/cebe-php-openapi` fixed those signatures upstream, so the
        suppression was removed and the suite runs clean without it — measured,
        not assumed. Put it back only with a new reason written next to it.
    -->
  <source restrictNotices="true" restrictWarnings="true">
    <include>
      <directory suffix=".php">./src</directory>
      <directory suffix=".php">./runtime/src</directory>
    </include>
  </source>
</phpunit>
